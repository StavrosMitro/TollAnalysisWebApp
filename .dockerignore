# VCS
.git
.gitignore

# Dependencies (reinstalled inside the image)
**/node_modules

# Build output
front-end/build
back-end/client

# Local env / secrets
**/.env
**/.env.*
!**/.env.example

# Runtime / generated artefacts
back-end/var
back-end/uploads1
cli-client/token.json
# Legacy hash-generation helper contains intentionally fictional but known
# local fixture credentials. It is neither needed nor acceptable in runtime
# image layers.
back-end/hashPassword.js
cli-client
# Tests run on the host/CI and are not imported by the production server.
back-end/testing

# Editor / OS noise
**/*.log
.DS_Store
.vscode
.idea

# Docs that don't belong in the image
documentation
*.md
!README.md

# Python caches
**/__pycache__
**/*.pyc
