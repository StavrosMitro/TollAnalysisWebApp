# Backend configuration for NON-container local development
# (`cd back-end && npm install && node server.js`).
# Copy to ".env":  cp .env.example .env
#
# When running via docker-compose these values come from the root .env /
# compose defaults instead - this file is only for running the backend
# directly on the host.

NODE_ENV=development
PORT=9115

# --- Database (a locally installed MySQL) ---
HOST=127.0.0.1
DB_PORT=3306
DUSER=root
PASSWORD=
DATABASE=toll_analysis

# --- Auth ---
# In development a missing JWT_SECRET falls back to an insecure value with a
# warning. In production (NODE_ENV=production) it is REQUIRED and must be
# >= 32 bytes of high-entropy material: openssl rand -hex 32
JWT_SECRET=dev_local_jwt_secret_change_me_please_at_least_32_bytes_long
JWT_EXPIRES_IN=1h
DEMO_TOKEN_TTL_MINUTES=90

# --- CORS ---
# The dev frontend runs on http://localhost:3000 (default when this is unset).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Feature flags ---
DISABLE_DESTRUCTIVE_OPS=false
PUBLIC_DEMO_MODE=false
TRUST_PROXY=false
INFERENCE_TIMEOUT_MS=20000
INFERENCE_MAX_CONCURRENT=2

# --- Python / ML ---
# Interpreter that has back-end/requirements.txt installed.
PYTHON_BIN=python3
# Where prediction input/output CSVs are written (kept out of the source tree).
# Defaults to back-end/var when unset.
# RUNTIME_DIR=/tmp/toll-analysis-runtime
