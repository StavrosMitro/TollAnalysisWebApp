# Copy to ".env" (same directory) to override docker-compose defaults.
#   cp .env.example .env
# The stack runs without this file using the defaults shown here, which are
# suitable ONLY for local use.

# --- Database ---
DATABASE=toll_analysis
DUSER=toll_app
PASSWORD=toll_app_local_only
MYSQL_ROOT_PASSWORD=root_local_only

# --- Auth ---
# REQUIRED for any non-local use. Must be >= 16 chars and not a known-weak
# value (e.g. "mySuperSecretKey", "secret", "changeme") or the backend refuses
# to start when NODE_ENV=production. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=local_demo_only_change_me_0e5b1f2a7c9d4e6f
JWT_EXPIRES_IN=1h

# --- CORS ---
# Comma-separated allowed origins for cross-origin (non same-origin) access.
# Leave empty for the bundled same-origin stack.
CORS_ALLOWED_ORIGINS=

# --- Feature flags ---
# true  -> model training, DB resets, debt mutation and bulk upload return 503
# false -> those admin-only endpoints are live
DISABLE_DESTRUCTIVE_OPS=true

# --- Host port mappings (optional) ---
APP_HOST_PORT=9115
DB_HOST_PORT=3307
ADMINER_HOST_PORT=8081

# --- Seeded login accounts (from db/init/02-data.sql) ---
# admin@yme.gov.gr        / yme123!        (role: admin)
# admin@aodos.gr          / Aodos123!      (role: aodos)
# admin@gefyra.gr         / Gefyra123!     (role: gefyra)
# admin@egnatia.eu        / Egnatia123!    (role: egnatia)
# admin@kentrikiodos.gr   / Kentriki123!   (role: kentrikiodos)
# admin@moreas.com.gr     / Moreas123!     (role: moreas)
# admin@neaodos.gr        / Neaodos123!    (role: neaodos)
# admin@olympiaodos.gr    / Olympia123!    (role: olympiaodos)
