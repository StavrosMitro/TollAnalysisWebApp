# Copy to ".env" (same directory) to override docker-compose defaults.
#   cp .env.example .env
# The stack runs without this file using the defaults shown here, which are
# suitable ONLY for local use.

# --- Database ---
DATABASE=toll_analysis
DUSER=toll_app
PASSWORD=toll_app_local_only
MYSQL_ROOT_PASSWORD=root_local_only

# --- Auth ---
# REQUIRED for any non-local use. Must be >= 32 bytes of high-entropy material
# and not a known-weak value, or the backend refuses to start when
# NODE_ENV=production. GENERATE YOUR OWN - do not reuse this one:
#   openssl rand -hex 32
# The value below is a valid-shaped throwaway for zero-config local runs ONLY.
JWT_SECRET=fb3afa47072220b5dc1798863721abb11e1c6272afe911376655a2363f4b6eaa
JWT_EXPIRES_IN=1h

# Public demo token lifetime, clamped to 60-120 minutes (default 90).
DEMO_TOKEN_TTL_MINUTES=90

# --- CORS ---
# Comma-separated allowed origins for cross-origin (non same-origin) access.
# Leave empty for the bundled same-origin stack.
CORS_ALLOWED_ORIGINS=

# --- Feature flags ---
# true  -> training / DB resets / debt mutation / bulk upload / user admin
#          return 403 {"error":{"code":"DEMO_MODE_RESTRICTION"}}
# false -> those admin-only endpoints are live (the `demo` role still cannot
#          reach them - they require an admin token)
DISABLE_DESTRUCTIVE_OPS=true

# --- Host port mappings (optional) ---
APP_HOST_PORT=9115
DB_HOST_PORT=3307
ADMINER_HOST_PORT=8081

# --- Public demo (no credentials needed) ---
# POST /api/auth/demo-login  ->  short-lived token, role "demo" (read-only).
# Seeded fictional identity: demo@toll-analysis.example  (db/init/03-demo-account.sql)

# --- Seeded login accounts (from db/init/02-data.sql) ---
# admin@yme.gov.gr        / yme123!        (role: admin)
# admin@aodos.gr          / Aodos123!      (role: aodos)
# admin@gefyra.gr         / Gefyra123!     (role: gefyra)
# admin@egnatia.eu        / Egnatia123!    (role: egnatia)
# admin@kentrikiodos.gr   / Kentriki123!   (role: kentrikiodos)
# admin@moreas.com.gr     / Moreas123!     (role: moreas)
# admin@neaodos.gr        / Neaodos123!    (role: neaodos)
# admin@olympiaodos.gr    / Olympia123!    (role: olympiaodos)
