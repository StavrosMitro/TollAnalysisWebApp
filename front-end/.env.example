# Frontend build/runtime configuration (Create React App reads REACT_APP_*).
# Copy to ".env" for local non-container development:  cp .env.example .env

# Base URL of the backend REST API.
#
# - Leave UNSET for the docker-compose stack and for production: the React
#   build is served by the backend on the same origin, so the app uses "/api".
# - Set it when running `npm start` (CRA dev server on :3000) against a
#   separately running backend:
REACT_APP_API_BASE_URL=http://localhost:9115/api
